# Crestron TSW-xx70 (APQ8053) fragment on top of defconfig:
#   make defconfig tsx-xx70.config
# Everything the installer initramfs needs is built in (it loads no modules).

# --- SoC: MSM8953/APQ8053 clocks, pins, interconnect, CPU power and scaling ---
CONFIG_NR_CPUS=8
CONFIG_SCHED_CLUSTER=y
CONFIG_MSM_GCC_8953=y
CONFIG_PINCTRL_MSM8953=y
CONFIG_INTERCONNECT_QCOM_MSM8953=y
CONFIG_QCOM_BAM_DMA=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y
# CPR4 (APC voltage) and the APCS CPU/CCI clocks: cpufreq through qcom-cpufreq-nvmem
CONFIG_QCOM_CPR4PD=y
CONFIG_QCOM_CLK_APCS_MSM8953=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_THERMAL_GOV_USER_SPACE=y

# --- Storage ---
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y

# --- USB host + LAN9512 Ethernet + USB keyboards/sticks on the rear ports ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- Bootloader framebuffer handed over by lk2nd, with a console on it ---
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y

# --- Touch, keys, PMIC ---
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYCON_HY46XX=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
# PON creates the reset-pinhole (RESIN) key
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
# PM8953 MPPs (MPP4 carries the backlight PWM)
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y

# --- Crash logs via lk2nd ramoops ---
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- Networking in the initramfs ---
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# --- Lightbar (LP5024 variants) ---
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_LP50XX=m

# --- Native display and backlight ---
# These modular dependencies would otherwise cap them at =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_PBS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_BACKLIGHT_PWM=y

# --- Wi-Fi/BT (WCNSS), built in; firmware comes from the initramfs ---
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_WCNSS_PIL=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_QCOM_SYSMON=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WCN36XX=y
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_QCOMSMD=y

# --- Misc ---
# The PM8953 RTC cannot be set (no allow-set-time in the DT) and the board has
# no battery: do not tie the system clock to it (as the msm8953 configs do).
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
# Firmware comes from the initramfs or the rootfs, never from a userspace helper
# CONFIG_FW_LOADER_USER_HELPER is not set
# uinput as a module: input injection for tests with `modprobe uinput`
CONFIG_INPUT_UINPUT=m

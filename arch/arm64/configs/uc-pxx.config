# Crestron UC-Pxx (RK3399) fragment on top of defconfig:
#   make defconfig uc-pxx.config
# Everything that the boot initramfs needs is built in (it loads no modules).
# The initramfs is built into the Image. Set it with the boot image build:
#   CONFIG_INITRAMFS_SOURCE="<path to the cpio>"
#   CONFIG_INITRAMFS_COMPRESSION_XZ=y

# --- Platform: Rockchip only ---
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_ROCKCHIP=y
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
CONFIG_NR_CPUS=8

# --- CPU DVFS and thermal (DDR DVFS stays off: not proven safe on this board) ---
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
# CONFIG_ARM_RK3399_DMC_DEVFREQ is not set
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_THERMAL_GOV_USER_SPACE=y

# --- PMIC and rails: RK808, SYR827 (vdd_cpu_b), SYR828 (vdd_gpu) ---
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_RTC_DRV_RK808=y
# The RK808 RTC is not set at boot: do not copy it to or from the system time
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_I2C_RK3X=y

# --- Display: VOP -> MIPI DSI -> panel, PWM backlight, rotated console ---
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_CRESTRON_UC_P10=y
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# --- GPU, video codecs and 2D (the media core must be built in for =y drivers) ---
CONFIG_DRM_PANFROST=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_VDEC=y
CONFIG_VIDEO_ROCKCHIP_RGA=y

# --- Ethernet: GMAC -> RTL8364B switch (fixed link) ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHYLINK=y
CONFIG_REALTEK_PHY=y
CONFIG_REALTEK_RTL8364B_SMI=y
CONFIG_IPV6=y

# --- USB-C: fusb302 + TCPM, dwc3 dual role, configfs gadget ---
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_EXTCON=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Touchscreen with T15 touch keys, ambient light, ADC keys ---
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_JSA1212=y
CONFIG_ROCKCHIP_SARADC=y

# --- Wi-Fi and Bluetooth: AP6256 (BCM43456 SDIO, BCM4345C5 UART) ---
# mmc pwrseq-simple gets reset-gpios through the reset-gpio driver: =m defers it forever
CONFIG_RESET_GPIO=y
CONFIG_PWRSEQ_SIMPLE=y
# CFG80211 and BT are limited to =m while RFKILL=m
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# BT_HCIUART is limited to =m while POWER_SEQUENCING=m
CONFIG_POWER_SEQUENCING=y
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y

# --- Audio: I2S0 -> AIC3104 + TAS5825M (audio-graph-card2), BT SCO on I2S1 ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_TLV320AIC3X_I2C=y
CONFIG_SND_SOC_TAS5825M=y
CONFIG_SND_SOC_BT_SCO=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_AUDIO_GRAPH_CARD2=y

# --- Debug and userspace tools ---
# The initramfs diagnostic tools read registers through /dev/mem
# CONFIG_STRICT_DEVMEM is not set
CONFIG_DYNAMIC_DEBUG=y
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_INPUT_UINPUT=m
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

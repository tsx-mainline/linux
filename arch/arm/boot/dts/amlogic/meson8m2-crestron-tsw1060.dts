/*
 * Crestron TSW-1060 and TSS-10 (board "yushan_one", 10-inch 1280x800 LVDS
 * panel). Common parts: meson8m2-crestron-tsw-xx60.dtsi.
 */

/dts-v1/;

#include "meson8m2-crestron-tsw-xx60.dtsi"
#include <dt-bindings/media/video-interfaces.h>

/ {
	model = "Crestron TSW-1060";
	compatible = "crestron,tsw1060", "amlogic,meson8m2";

	chosen {
		/* U-Boot env: fb_addr=0x07900000, 24 bpp, COLOR_INDEX_24_RGB (R at bit 16) */
		framebuffer@7900000 {
			compatible = "simple-framebuffer";
			reg = <0x07900000 (1280 * 800 * 3)>;
			width = <1280>;
			height = <800>;
			stride = <(1280 * 3)>;
			format = "r8g8b8";
			/*
			 * Keep the LVDS pipeline U-Boot set up alive (verified
			 * without clk_ignore_unused/pd_ignore_unused):
			 * - cts_encl is required: it holds the whole chain
			 *   vid2_pll_dco .. viid_pll_lvds_en .. vclk2_div1.
			 * - the vclk2_vencl/venclmcc and vpu_intr gates are
			 *   CLK_IGNORE_UNUSED pclks and survive anyway; they are
			 *   listed so the dependency is explicit.
			 * - vpu is also held by the pwrc, which marks the VPU
			 *   domain always-on when U-Boot left it powered.
			 */
			clocks = <&clkc CLKID_CTS_ENCL>,
				 <&clkc CLKID_VIID_PLL_LVDS_EN>,
				 <&clkc CLKID_VCLK2_VENCL>,
				 <&clkc CLKID_VCLK2_VENCLMCC>,
				 <&clkc CLKID_VPU_INTR>,
				 <&clkc CLKID_VPU>;
			power-domains = <&pwrc PWRC_MESON8_VPU_ID>;
			status = "okay";
		};
	};

	/*
	 * LVDS panel: 10.1-inch 1280x800, single link, 8 bit, VESA mapping.
	 * Timings from the vendor lcd_LP097X02 node (yushan_one_10inch.dtd) and the
	 * live vendor driver: total 1360x835, 68.136 MHz, hsync 20/30 (high),
	 * vsync 2/4 (low). Power: the regulator chain in the dtsi.
	 */
	panel: panel {
		compatible = "crestron,tsw1060-panel", "panel-lvds";
		width-mm = <217>;
		height-mm = <136>;
		data-mapping = "vesa-24";
		power-supply = <&panel_pwr>;
		backlight = <&backlight>;

		panel-timing {
			clock-frequency = <68136000>;
			hactive = <1280>;
			vactive = <800>;
			hfront-porch = <30>;
			hsync-len = <20>;
			hback-porch = <30>;
			vfront-porch = <29>;
			vsync-len = <2>;
			vback-porch = <4>;
			hsync-active = <1>;
			vsync-active = <0>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&vpu_lvds_out>;
			};
		};
	};

	/*
	 * Vendor U-Boot display configuration, the 10-inch values
	 * (yushan_one_10inch).
	 * For the vendor U-Boot only: see the comment above /vpu in
	 * meson8m2-crestron-tsw-xx60.dtsi. The vendor keeps the model name
	 * LP097X02 on every panel size.
	 */
	bl_extern_i2c_mp3309c {
		compatible = "amlogic,bl_i2c_mp3309c";
		dev_name = "bl_i2c_mp3309c";
		status = "okay";
		gpio_enable_on_off = "GPIODV_28", "1", "0";
		type = <0>;
		i2c_address = <0x17>;
		i2c_bus = "i2c_bus_b";
		dim_max_min = <23 1>;
		dim_max_min_edt = <24 2>;
	};

	lcd_LP097X02 {
		model_name = "LP097X02";
		interface = "lvds";
		active_area = <217 136>;
		lcd_bits_option = <8 1>;
		resolution = <1280 800>;
		period = <1360 835>;
		clock_hz_pol = <68136000 0>;
		hsync_width_backporch = <20 30>;
		vsync_width_backporch = <2 4>;
		pol_hsync_vsync = <1 12>;
		max_lane_count = <4>;
	};
};

&touchscreen {
	touchscreen-size-x = <1280>;
	touchscreen-size-y = <800>;

	/*
	 * The glass extends to the right of the LCD: five capacitive
	 * keys in a column at x = 1310..1380 of the touch controller
	 * (vendor tpkey_1..5, reported by the vendor FocalTech driver
	 * as KEY_BACK, KEY_HOME, KEY_MUTE, KEY_VOLUMEUP,
	 * KEY_VOLUMEDOWN). Here the areas are widened by 20 units and
	 * report KEY_F13..KEY_F17, keys that neither Chromium nor
	 * the compositor act on; userspace (tsx-buttons) maps them.
	 * The touchscreen segment drops contacts outside the LCD.
	 */
	touch-overlay {
		segment-screen {
			label = "screen";
			x-origin = <0>;
			x-size = <1280>;
			y-origin = <0>;
			y-size = <800>;
		};

		segment-key1 {
			label = "key1";
			linux,code = <KEY_F13>;
			x-origin = <1290>;
			x-size = <120>;
			y-origin = <30>;
			y-size = <130>;
		};

		segment-key2 {
			label = "key2";
			linux,code = <KEY_F14>;
			x-origin = <1290>;
			x-size = <120>;
			y-origin = <190>;
			y-size = <130>;
		};

		segment-key3 {
			label = "key3";
			linux,code = <KEY_F15>;
			x-origin = <1290>;
			x-size = <120>;
			y-origin = <330>;
			y-size = <130>;
		};

		segment-key4 {
			label = "key4";
			linux,code = <KEY_F16>;
			x-origin = <1290>;
			x-size = <120>;
			y-origin = <480>;
			y-size = <130>;
		};

		segment-key5 {
			label = "key5";
			linux,code = <KEY_F17>;
			x-origin = <1290>;
			x-size = <120>;
			y-origin = <630>;
			y-size = <130>;
		};
	};
};

/* Audio: AIU I2S -> ZLS38051 -> 2x TFA9890 (after the panel: node order) */
#include "meson8m2-crestron-tsw1060-audio.dtsi"

/*
 * Camera: an OmniVision OV5640 on I2C_D at 0x3c, 2-lane MIPI CSI-2. The
 * vendor board file names an OV5645, but the sensor on the TSS-10 reads
 * chip ID 0x5640 (revision 0xb0). Mainline has no Meson8 CSI-2 receiver,
 * so the endpoint has no remote. This node only lets the sensor driver
 * power the sensor and read its chip ID.
 *
 * GPIOH_6 is the power-down line (high powers the sensor down, as in the
 * vendor OV5640 entry). GPIOH_4 is the reset line (active low). The master
 * clock is 24 MHz from GEN_CLK (XTAL, divider 1) on GPIOH_9. The vendor
 * never switches a camera supply, so the three supplies are fixed and
 * always on. Their voltages are the OV5640 nominal values.
 */
/ {
	cam_dovdd: regulator-cam-dovdd {
		compatible = "regulator-fixed";
		regulator-name = "CAM_DOVDD";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	cam_avdd: regulator-cam-avdd {
		compatible = "regulator-fixed";
		regulator-name = "CAM_AVDD";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	cam_dvdd: regulator-cam-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "CAM_DVDD";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-always-on;
	};
};

&pinctrl_cbus {
	gen_clk_h_pins: gen-clk-h {
		mux {
			groups = "gen_clk_h";
			function = "gen_clk";
			bias-disable;
		};
	};
};

&mipi_csi2 {
	status = "okay";

	port {
		mipi_csi2_in: endpoint {
			remote-endpoint = <&ov5640_out>;
			data-lanes = <1 2>;
		};
	};
};

&i2c_D {
	status = "okay";
	pinctrl-0 = <&i2c_d1_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;

	camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		pinctrl-0 = <&gen_clk_h_pins>;
		pinctrl-names = "default";
		clocks = <&clkc CLKID_GEN_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&clkc CLKID_GEN_CLK>;
		assigned-clock-rates = <24000000>;
		powerdown-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio GPIOH_4 GPIO_ACTIVE_LOW>;
		DOVDD-supply = <&cam_dovdd>;
		AVDD-supply = <&cam_avdd>;
		DVDD-supply = <&cam_dvdd>;

		port {
			ov5640_out: endpoint {
				remote-endpoint = <&mipi_csi2_in>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
	};
};

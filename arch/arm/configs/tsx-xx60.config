# TSW-760/1060 (Meson8m2) fragment on top of multi_v7_defconfig
CONFIG_ARCH_MESON=y
CONFIG_MACH_MESON8=y
# multi_v7 enables AXXIA which forces TEXT_OFFSET 0x308000; keep Meson's 0x208000
# (first 2 MiB are the no-map "hwrom" region)
# CONFIG_ARCH_AXXIA is not set
CONFIG_COMMON_CLK_MESON8B=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_MMC_MESON_MX_SDHC=y
CONFIG_MMC_MESON_MX_SDIO=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_MESON=y
CONFIG_ICPLUS_PHY=y
CONFIG_USB_DWC2=y
CONFIG_PHY_MESON8B_USB2=y
CONFIG_USB_STORAGE=y
CONFIG_PWM=y
CONFIG_PWM_MESON=y
CONFIG_I2C_MESON=y
CONFIG_I2C_CHARDEV=y
CONFIG_MFD_RN5T618=y
CONFIG_REGULATOR_RN5T618=y
CONFIG_RTC_DRV_RC5T619=y
CONFIG_INPUT_EVDEV=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_MP3309C=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Stock bootargs have no console= (the kernel gets the literal text
# "${bootargs_console}"); append the serial console to the bootloader cmdline.
# console=tty0 last: /dev/console is the panel (fbcon on the U-Boot framebuffer).
# clk/pd_ignore_unused are NOT built in: pass them per boot (extra bootargs)
# so the keep-alive list can be tested without a rebuild.
CONFIG_CMDLINE="console=ttyAML0,115200n8 console=tty0 loglevel=7"
CONFIG_CMDLINE_EXTEND=y
# U-Boot bootargs carry ramoops.mem_address=0x04e00000, which the DT does not
# reserve; a built-in ramoops would write into live RAM.
# CONFIG_PSTORE_RAM is not set
# --- SoC and board basics (built in: the rescue initramfs carries no modules) ---
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_CLK_MEASURE=y
CONFIG_MESON_SARADC=y
CONFIG_IIO=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_USB=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_MESON8B_USB2=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
# GPIO_SYSFS is only visible with EXPERT, which multi_v7_defconfig no longer sets
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
# SoC temperature: saradc channel 8 + efuse calibration + generic-adc-thermal
CONFIG_NVMEM_MESON_MX_EFUSE=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_KEYBOARD_GPIO_POLLED=y
# --- Display: drm/meson LVDS output (built in: no modules in the initramfs) ---
CONFIG_DRM_MESON=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_DRM_LIMA=y
# --- Kiosk userland ---
# Chromium sandbox (user/PID/net namespaces; without them the kiosk runs
# Chromium with --no-sandbox)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
# compressed swap in RAM (tsx-setup enables it); built in: the rootfs ships no modules
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
# --- Front-panel key LEDs (gpio-leds enables + pwm-leds on PWM_C) ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
# --- RGB LED bar (STM32 on USB0 port 1, 14be:001b interface 1) ---
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_CRESTRON_STM32=y
# usbmon for the bring-up (capture the Cresnet traffic: /sys/kernel/debug/usb/usbmon)
CONFIG_USB_MON=y

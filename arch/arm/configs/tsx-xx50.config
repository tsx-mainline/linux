# CONFIG_CRYPTO_DEV_FSL_CAAM is not set
# CONFIG_CRYPTO_DEV_MXS_DCP is not set
CONFIG_CRYPTO_DEV_SAHARA=m
# CONFIG_IMX_WEIM is not set
# CONFIG_IMX_THERMAL is not set

# tsx-xx50: Crestron TSS-752 (i.MX53) first-light kernel.
# Merge on top of imx_v6_v7_defconfig:
#   make imx_v6_v7_defconfig tsx-xx50.config
# The stock U-Boot 2009.08 reads the kernel slot with a fixed size of 4 MiB
# (0x2000 sectors), so zImage plus the appended DTB must stay below 4 MiB.
# Most drivers that first light does not need are modules or off.

CONFIG_LOCALVERSION="-tsx-xx50"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_XZ=y

# Only the i.MX53, one core.
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_SOC_IMX31 is not set
# CONFIG_SOC_IMX35 is not set
# CONFIG_SOC_IMX50 is not set
# CONFIG_SOC_IMX51 is not set
CONFIG_SOC_IMX53=y
# CONFIG_SOC_IMX6Q is not set
# CONFIG_SOC_IMX6SL is not set
# CONFIG_SOC_IMX6SLL is not set
# CONFIG_SOC_IMX6SX is not set
# CONFIG_SOC_IMX6UL is not set
# CONFIG_SOC_IMX7D is not set
# CONFIG_SOC_IMX7ULP is not set
# CONFIG_SOC_VF610 is not set
# CONFIG_SOC_IMX8M is not set
# CONFIG_CLK_IMX8MM is not set
# CONFIG_CLK_IMX8MN is not set
# CONFIG_CLK_IMX8MP is not set
# CONFIG_CLK_IMX8MQ is not set
# CONFIG_SMP is not set
# CONFIG_ARM_PSCI is not set
# CONFIG_KEXEC is not set
# CONFIG_KPROBES is not set
# CONFIG_PCI is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CGROUPS is not set
# CONFIG_NETFILTER is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_RELAY is not set
# CONFIG_CONNECTOR is not set
# CONFIG_SPI is not set
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
# CONFIG_TEE is not set
# CONFIG_OPTEE is not set

# Boot glue for the stock U-Boot: legacy ATAG boot, no FDT support in the
# loader. The DTB is appended to the zImage. The decompressor merges the ATAG
# memory banks and the initrd location into it. The command line of U-Boot is
# an Android one, so the kernel uses its own fixed command line.
# fbcon=map:1 maps the text consoles to a framebuffer that does not exist,
# so no kernel text reaches the LCD. The boot splash of the initramfs owns
# the screen until the panel app takes it. tty1 keeps the kernel log for a
# boot with the text console on the LCD (tsx-splash console).
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE="console=ttymxc0,115200 console=tty1 fbcon=map:1 root=PARTUUID=7458a050-02 rootfstype=ext4 rootwait=60 rw panic=10 softlockup_panic=1 clk_ignore_unused consoleblank=0 loglevel=7 init=/sbin/init"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_PANIC_TIMEOUT=10
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# cpufreq with the generic DT driver. The board DTS gives the vendor
# operating points and the CPU supply (DA9053 BUCKCORE). U-Boot starts the
# CPU at 1 GHz. No cpuidle.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
# CONFIG_ARM_IMX6Q_CPUFREQ is not set
# CONFIG_ARM_IMX_CPUFREQ_DT is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_TEST_SUSPEND is not set

# Logs that survive a warm reset (watchdog): ramoops in a reserved DRAM area.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=17

# Storage and file systems.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_QUOTA is not set
# CONFIG_FUSE_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_BLK_DEV_RAM is not set
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_MSDOS_FS=m

# Network: FEC (RMII) with any PHY. The PHY ID is not known yet.
CONFIG_FEC=y
CONFIG_PHYLIB=y
CONFIG_SMSC_PHY=y
CONFIG_MICREL_PHY=y
CONFIG_NATIONAL_PHY=y
CONFIG_DP83848_PHY=y
CONFIG_REALTEK_PHY=y
# CONFIG_AT803X_PHY is not set
# CONFIG_DP83867_PHY is not set
# CONFIG_SMC91X is not set
# CONFIG_SMSC911X is not set
# CONFIG_CS89x0_PLATFORM is not set
# CONFIG_QCA7000_SPI is not set
# CONFIG_CAN is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_WLAN is not set
# CONFIG_IP_PNP is not set
CONFIG_IPV6=y
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_MCS7830=m

# I2C, GPIO, PWM, PMIC, watchdog.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_IMX=y
# CONFIG_I2C_MUX_GPIO is not set
# CONFIG_I2C_GPIO is not set
# CONFIG_SPI_FSL_QUADSPI is not set
# CONFIG_SPI_FSL_DSPI is not set
CONFIG_GPIO_MXC=y
CONFIG_GPIO_SYSFS=y
# CONFIG_GPIO_MAX732X is not set
# CONFIG_GPIO_PCA953X is not set
# CONFIG_GPIO_PCF857X is not set
# CONFIG_GPIO_BD71815 is not set
# CONFIG_GPIO_STMPE is not set
# CONFIG_GPIO_74X164 is not set
CONFIG_PWM=y
CONFIG_PWM_IMX27=y
# CONFIG_PWM_FSL_FTM is not set
# CONFIG_PWM_IMX_TPM is not set
CONFIG_MFD_DA9052_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_DA9052=y
# CONFIG_MFD_DA9062 is not set
# CONFIG_MFD_DA9063 is not set
# CONFIG_MFD_MC13XXX_SPI is not set
# CONFIG_MFD_MC13XXX_I2C is not set
# CONFIG_MFD_SY7636A is not set
# CONFIG_MFD_RN5T618 is not set
# CONFIG_MFD_STMPE is not set
# CONFIG_MFD_ROHM_BD71828 is not set
# CONFIG_REGULATOR_ANATOP is not set
# CONFIG_REGULATOR_LTC3676 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_IMX2_WDT=y
CONFIG_DA9052_WATCHDOG=y
# CONFIG_IMX7ULP_WDT is not set
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_DA9052=y
CONFIG_RTC_DRV_MXC=y
CONFIG_RTC_DRV_MXC_V2=y
# CONFIG_RTC_DRV_DS1307 is not set
# CONFIG_RTC_DRV_ISL1208 is not set
# CONFIG_RTC_DRV_PCF8523 is not set
# CONFIG_RTC_DRV_PCF8563 is not set
# CONFIG_RTC_DRV_M41T80 is not set
# CONFIG_RTC_DRV_BD70528 is not set
# CONFIG_RTC_DRV_RC5T619 is not set
# CONFIG_RTC_DRV_RV3029C2 is not set
# CONFIG_RTC_DRV_DA9063 is not set
# CONFIG_RTC_DRV_MC13XXX is not set
# CONFIG_RTC_DRV_SNVS is not set
CONFIG_HWMON=y
CONFIG_SENSORS_DA9052_ADC=m
CONFIG_INPUT_DA9052_ONKEY=m
CONFIG_LEDS_DA9052=m
CONFIG_EEPROM_AT24=m
# CONFIG_EEPROM_AT25 is not set

# The two RGB light bars: two TLC59116, one multicolor LED for each bar.
CONFIG_LEDS_TLC591XX=m
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_GROUP_MULTICOLOR=m

# Display: IPU parallel output, simple panel, fbdev console for the status screen.
CONFIG_DRM=y
CONFIG_IMX_IPUV3_CORE=y
CONFIG_DRM_IMX=y
CONFIG_DRM_IMX_PARALLEL_DISPLAY=y
# CONFIG_DRM_IMX_TVE is not set
# CONFIG_DRM_IMX_LDB is not set
# CONFIG_DRM_IMX_HDMI is not set
CONFIG_DRM_PANEL_SIMPLE=y
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_SEIKO_43WVF1G is not set
# CONFIG_DRM_PANEL_EDP is not set
# CONFIG_DRM_DISPLAY_CONNECTOR is not set
# CONFIG_DRM_I2C_NXP_TDA998X is not set
# CONFIG_DRM_SII902X is not set
# CONFIG_DRM_TI_TFP410 is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_MXSFB is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_FONT_8x8 is not set
# CONFIG_LOGO is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_GPIO=y
# CONFIG_LCD_L4F00242T03 is not set
# CONFIG_LCD_PLATFORM is not set

# GPU: the AMD Z430 (Adreno 200) of the i.MX53 with drm/msm, render only.
# imx53.dtsi has the "amd,imageon" node. The a2xx GPU MMU maps the buffers,
# so no IOMMU and no reserved memory. The display stays on imx-drm. Mesa
# pairs the two (kmsro). The CP firmware yamato_pm4.fw and yamato_pfp.fw
# comes from linux-firmware at the first open, so the driver is a module.
CONFIG_DRM_MSM=m
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set

# Input: touch and test tools.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# CONFIG_TOUCHSCREEN_ADS7846 is not set
# CONFIG_TOUCHSCREEN_AD7879 is not set
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_CYTTSP5 is not set
# CONFIG_TOUCHSCREEN_DA9052 is not set
# CONFIG_TOUCHSCREEN_EGALAX is not set
# CONFIG_TOUCHSCREEN_GOODIX is not set
# CONFIG_TOUCHSCREEN_ILI210X is not set
# CONFIG_TOUCHSCREEN_MAX11801 is not set
# CONFIG_TOUCHSCREEN_IMX6UL_TSC is not set
# CONFIG_TOUCHSCREEN_MC13783 is not set
# CONFIG_TOUCHSCREEN_TSC2004 is not set
# CONFIG_TOUCHSCREEN_TSC2007 is not set
# CONFIG_TOUCHSCREEN_STMPE is not set
# CONFIG_TOUCHSCREEN_SX8654 is not set
# CONFIG_TOUCHSCREEN_COLIBRI_VF50 is not set
# CONFIG_INPUT_MMA8450 is not set
# CONFIG_INPUT_PWM_BEEPER is not set
# CONFIG_KEYBOARD_SNVS_PWRKEY is not set
# CONFIG_KEYBOARD_IMX is not set
# CONFIG_MOUSE_PS2 is not set
# CONFIG_RC_CORE is not set
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
# CONFIG_SERIAL_FSL_LPUART is not set

# USB: chipidea OTG and host, as modules.
CONFIG_USB=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_CHIPIDEA=m
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_NOP_USB_XCEIV=m
# CONFIG_USB_MXS_PHY is not set
# CONFIG_USB_HSIC_USB3503 is not set
# CONFIG_USB_ONBOARD_DEV is not set
CONFIG_USB_STORAGE=m
CONFIG_USB_GADGET=m
CONFIG_USB_G_SERIAL=m
CONFIG_USB_ETH=m
CONFIG_HID_MULTITOUCH=m
# CONFIG_HID_WACOM is not set
# CONFIG_I2C_HID_OF is not set

# Audio playback: SSI2 and the AUDMUX to the TLV320AIC3204 codec, a
# simple-audio-card and the speaker amplifier enable GPIO. SDMA moves the
